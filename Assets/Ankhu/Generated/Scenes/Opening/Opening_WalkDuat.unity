--- !u!114 &668149433
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 668149432}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 291b2cd1c879c9048aa323ce5050922a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Ankhu.Opening::Ankhu.Opening.WalkProgress
  path: {fileID: 69303561}
  player: {fileID: 110596947}
  director: {fileID: 1611496693}
  sequence: {fileID: 1112450709}
  thresholds:
  - 0
  - 9
  - 14
  - 32
  - 52
  - 61
  hysteresis: 0.8
  beats:
  - name: cam2
    start: 10.5
    lines:
    - ankhu: 1
      clip: {fileID: 8300000, guid: 2a44e1344d0955e45997fab61d769884, type: 3}
      text: I served your house for forty years. I wore your face over the dead.
    - ankhu: 0
      clip: {fileID: 8300000, guid: 6aa24d9ea06fa6e4aa20d9985c7a4b43, type: 3}
      text: I know. I was there each time you lifted the mask.
    endsScene: 0
  - name: cam3
    start: 17
    lines:
    - ankhu: 1
      clip: {fileID: 8300000, guid: 9db0c0ac3691d664cad24dd70eb25910, type: 3}
      text: Then you know what I was before that.
    - ankhu: 0
      clip: {fileID: 8300000, guid: d1ab541430600a84d8b0764d62952e87, type: 3}
      text: A son. A father. A husband. A man who stopped speaking.
    endsScene: 0
  - name: cam4
    start: 33.5
    lines:
    - ankhu: 1
      clip: {fileID: 8300000, guid: e56ccae8177e74b4f9c27645fd6e004e, type: 3}
      text: Will I see them?
    - ankhu: 0
      clip: {fileID: 8300000, guid: 43610b92006bb8a458fb3bc6957f4101, type: 3}
      text: The Duat keeps what the living lose. But the road asks something first.
    endsScene: 0
  - name: cam5
    start: 52.5
    lines:
    - ankhu: 1
      clip: {fileID: 8300000, guid: eba6796a623a6e04bbd1c3a2a959b527, type: 3}
      text: What does it ask?
    - ankhu: 0
      clip: {fileID: 8300000, guid: 8e4c837eedc94af4aafe9cecc76ee931, type: 3}
      text: Your name, at every gate. Hold it as you held it in the water.
    endsScene: 0
  - name: cam6
    start: 64
    lines:
    - ankhu: 0
      clip: {fileID: 8300000, guid: 4e3d37f4e2d5abf4c9e56ee3bcdb3fc6, type: 3}
      text: Walk with me, Ankhu. The night is long, and the gates are many.
    endsScene: 1
  pauseBetween: 0.5
