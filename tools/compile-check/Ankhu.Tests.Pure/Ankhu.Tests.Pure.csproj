<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the engine-free subset of the tests with `dotnet test` on .NET 8 (no Unity at all).
       Compiles: all of Runtime/Integration + every Runtime/** and Tests/EditMode/** .cs file that does not
       mention UnityEngine/UnityEditor/InputSystem (list generated by compile-check.sh into PureFiles.g.props). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Ankhu.Tests.Pure</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <DefineConstants>$(DefineConstants);UNITY_INCLUDE_TESTS;ANKHU_PURE_TESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(AnkhuRoot)Runtime/Integration/**/*.cs" />
  </ItemGroup>
  <Import Project="PureFiles.g.props" Condition="Exists('PureFiles.g.props')" />
  <ItemGroup>
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
  </ItemGroup>
</Project>
