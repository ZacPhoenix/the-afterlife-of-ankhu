<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the Unity package's Runtime sources outside Unity so bin/ and obj/ never land in the Unity tree. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>Ankhu.BorrowedDawn</RootNamespace>
    <AssemblyName>Ankhu.BorrowedDawn</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Packages/com.ankhu.borrowed-dawn/Runtime/**/*.cs" Link="Runtime/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
